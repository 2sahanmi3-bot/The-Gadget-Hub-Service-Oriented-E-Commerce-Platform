@page
@model GadgetHubClient.Pages.AboutModel
@{
    ViewData["Title"] = "About Us - The Gadget Hub";
}

<div class="about-section">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1 class="page-title">About The Gadget Hub</h1>
                <p class="page-subtitle">Your trusted partner in finding the best tech deals</p>
            </div>
        </div>
        
        <!-- Company Overview -->
        <div class="row mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <div class="about-intro">
                    <h2 class="section-title">Our Mission</h2>
                    <p class="lead">
                        The Gadget Hub is revolutionizing the way customers discover and purchase technology products. 
                        We connect you with the best deals from trusted distributors through our innovative 
                        service-oriented architecture.
                    </p>
                </div>
            </div>
        </div>
        
        <!-- How It Works -->
        <div class="row mb-5">
            <div class="col-12">
                <h2 class="section-title text-center mb-5">How It Works</h2>
            </div>
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="feature-card text-center">
                    <div class="feature-icon">
                        <i class="fas fa-search"></i>
                    </div>
                    <h4>1. Browse Products</h4>
                    <p>Explore our comprehensive catalog of gadgets from smartphones to laptops, all in one place.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="feature-card text-center">
                    <div class="feature-icon">
                        <i class="fas fa-balance-scale"></i>
                    </div>
                    <h4>2. Compare Prices</h4>
                    <p>Our system automatically compares prices from TechWorld, ElectroCom, and GadgetCentral.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="feature-card text-center">
                    <div class="feature-icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <h4>3. Get Best Deal</h4>
                    <p>We select the best offer based on price, availability, and delivery time for you.</p>
                </div>
            </div>
        </div>
        
        <!-- Architecture Diagram -->
        <div class="row mb-5">
            <div class="col-12">
                <h2 class="section-title text-center mb-5">Our Technology Architecture</h2>
                <div class="architecture-diagram">
                    <div class="card">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-3 text-center">
                                    <div class="arch-component customer">
                                        <i class="fas fa-user fa-2x"></i>
                                        <h5>Customer</h5>
                                        <p>Web Interface</p>
                                    </div>
                                </div>
                                <div class="col-md-1 text-center">
                                    <i class="fas fa-arrow-right fa-2x text-primary"></i>
                                </div>
                                <div class="col-md-3 text-center">
                                    <div class="arch-component hub">
                                        <i class="fas fa-hub fa-2x"></i>
                                        <h5>GadgetHub API</h5>
                                        <p>Service Layer</p>
                                    </div>
                                </div>
                                <div class="col-md-1 text-center">
                                    <i class="fas fa-arrow-right fa-2x text-primary"></i>
                                </div>
                                <div class="col-md-4">
                                    <div class="row">
                                        <div class="col-4 text-center">
                                            <div class="arch-component distributor">
                                                <i class="fas fa-building fa-lg"></i>
                                                <small>TechWorld</small>
                                            </div>
                                        </div>
                                        <div class="col-4 text-center">
                                            <div class="arch-component distributor">
                                                <i class="fas fa-building fa-lg"></i>
                                                <small>ElectroCom</small>
                                            </div>
                                        </div>
                                        <div class="col-4 text-center">
                                            <div class="arch-component distributor">
                                                <i class="fas fa-building fa-lg"></i>
                                                <small>GadgetCentral</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Our Partners -->
        <div class="row mb-5">
            <div class="col-12">
                <h2 class="section-title text-center mb-5">Our Trusted Partners</h2>
            </div>
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="partner-card text-center">
                    <div class="partner-logo">
                        <i class="fas fa-laptop-code fa-3x text-primary"></i>
                    </div>
                    <h4>TechWorld</h4>
                    <p>Leading distributor of premium technology products with extensive inventory and fast delivery.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="partner-card text-center">
                    <div class="partner-logo">
                        <i class="fas fa-microchip fa-3x text-warning"></i>
                    </div>
                    <h4>ElectroCom</h4>
                    <p>Specialized in electronic components and gadgets with competitive pricing and reliable service.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="partner-card text-center">
                    <div class="partner-logo">
                        <i class="fas fa-mobile-alt fa-3x text-success"></i>
                    </div>
                    <h4>GadgetCentral</h4>
                    <p>Your one-stop shop for the latest smartphones, tablets, and wearable technology.</p>
                </div>
            </div>
        </div>
        
        <!-- Why Choose Us -->
        <div class="row mb-5">
            <div class="col-12">
                <h2 class="section-title text-center mb-5">Why Choose The Gadget Hub?</h2>
            </div>
            <div class="col-lg-6 mb-4">
                <div class="benefit-item">
                    <div class="benefit-icon">
                        <i class="fas fa-dollar-sign"></i>
                    </div>
                    <div class="benefit-content">
                        <h5>Best Price Guarantee</h5>
                        <p>We automatically find the lowest prices from our network of distributors, ensuring you always get the best deal.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mb-4">
                <div class="benefit-item">
                    <div class="benefit-icon">
                        <i class="fas fa-shipping-fast"></i>
                    </div>
                    <div class="benefit-content">
                        <h5>Fast Delivery</h5>
                        <p>Our system considers delivery times when selecting the best distributor, so you get your products quickly.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mb-4">
                <div class="benefit-item">
                    <div class="benefit-icon">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <div class="benefit-content">
                        <h5>Trusted Partners</h5>
                        <p>All our distributors are verified and trusted partners, ensuring quality and reliability in every purchase.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mb-4">
                <div class="benefit-item">
                    <div class="benefit-icon">
                        <i class="fas fa-headset"></i>
                    </div>
                    <div class="benefit-content">
                        <h5>24/7 Support</h5>
                        <p>Our customer support team is always ready to help you with any questions or concerns.</p>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Call to Action -->
        <div class="row">
            <div class="col-12 text-center">
                <div class="cta-section">
                    <h3>Ready to Find Your Perfect Gadget?</h3>
                    <p class="lead">Join thousands of satisfied customers who have found their ideal tech products through The Gadget Hub.</p>
                    <a href="/Products" class="btn btn-primary btn-lg me-3">
                        <i class="fas fa-shopping-bag me-2"></i>Browse Products
                    </a>
                    <a href="/Contact" class="btn btn-outline-primary btn-lg">
                        <i class="fas fa-envelope me-2"></i>Contact Us
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
