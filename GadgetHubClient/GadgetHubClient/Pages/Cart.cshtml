@page
@model GadgetHubClient.Pages.CartModel
@{
    ViewData["Title"] = "Shopping Cart - The Gadget Hub";
}

<div class="cart-section">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1 class="page-title">Shopping Cart</h1>
                <p class="page-subtitle">Review your selected items before checkout</p>
            </div>
        </div>
        
        <div class="row">
            <div class="col-lg-8">
                <div class="cart-items" id="cartItems">
                    <!-- Cart items will be loaded here via JavaScript -->
                </div>
            </div>
            <div class="col-lg-4">
                <div class="cart-summary">
                    <div class="card">
                        <div class="card-header">
                            <h5>Order Summary</h5>
                        </div>
                        <div class="card-body">
                            <div class="summary-row">
                                <span>Subtotal:</span>
                                <span id="subtotal">Rs. 0</span>
                            </div>
                            <div class="summary-row">
                                <span>Shipping:</span>
                                <span id="shipping">Rs. 0</span>
                            </div>
                            <hr>
                            <div class="summary-row total">
                                <span><strong>Total:</strong></span>
                                <span id="total"><strong>Rs. 0</strong></span>
                            </div>
                            <div class="d-grid gap-2 mt-3">
                                <button class="btn btn-primary btn-lg" onclick="proceedToCheckout()">
                                    <i class="fas fa-credit-card"></i> Proceed to Checkout
                                </button>
                                <button class="btn btn-outline-secondary" onclick="continueShopping()">
                                    <i class="fas fa-arrow-left"></i> Continue Shopping
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Empty Cart Template -->
<div id="emptyCartTemplate" style="display: none;">
    <div class="empty-cart text-center">
        <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
        <h3>Your cart is empty</h3>
        <p class="text-muted">Add some products to get started!</p>
        <a href="/Products" class="btn btn-primary">Browse Products</a>
    </div>
</div>

@section Scripts {
    <script>
        let cart = [];
        let products = []; // Store product details from API
        
        async function loadCart() {
            try {
                // Load cart from session storage (temporary solution)
                cart = JSON.parse(sessionStorage.getItem('cart') || '[]');
                
                if (cart.length === 0) {
                    displayCartItems();
                    updateSummary();
                    return;
                }
                
                // Fetch product details for cart items
                await fetchProductDetails();
                displayCartItems();
                updateSummary();
            } catch (error) {
                console.error('Error loading cart:', error);
                showNotification('Error loading cart. Please try again.', 'error');
            }
        }
        
        async function fetchProductDetails() {
            try {
                const apiUrl = '@(Model.Configuration?["GadgetHubAPI:BaseUrl"] ?? "https://localhost:7063")';
                
                // Get all unique product IDs from cart
                const productIds = [...new Set(cart.map(item => item.productId).filter(id => id))];
                
                // Fetch product details for each product ID
                for (const productId of productIds) {
                    try {
                        const response = await fetch(`${apiUrl}/api/Quotation/product-details/${productId}?quantity=1`);
                        if (response.ok) {
                            const productData = await response.json();
                            products[productId] = productData;
                        }
                    } catch (error) {
                        console.error(`Error fetching product ${productId}:`, error);
                    }
                }
            } catch (error) {
                console.error('Error fetching product details:', error);
            }
        }
        
        function displayCartItems() {
            const cartItemsContainer = document.getElementById('cartItems');
            
            if (cart.length === 0) {
                cartItemsContainer.innerHTML = document.getElementById('emptyCartTemplate').innerHTML;
                return;
            }
            
            let html = '';
            cart.forEach((item, index) => {
                const productData = products[item.productId];
                const productName = productData?.productName || item.name || 'Unknown Product';
                const productImage = productData?.bestQuote?.thumbnail || `https://via.placeholder.com/100x100/667eea/ffffff?text=${encodeURIComponent(productName)}`;
                const unitPrice = productData?.bestQuote?.price || item.price || 0;
                const finalPrice = Math.round((unitPrice * 1.25) * 100) / 100; // Add 25% markup
                
                html += `
                    <div class="cart-item card mb-3" data-index="${index}">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-2">
                                    <img src="${productImage}" 
                                         alt="${productName}" class="img-fluid rounded">
                                </div>
                                <div class="col-md-4">
                                    <h6 class="mb-1">${productName}</h6>
                                    <small class="text-muted">Global ID: ${item.globalId}</small>
                                </div>
                                <div class="col-md-2">
                                    <span class="price">Rs. ${finalPrice.toLocaleString()}</span>
                                </div>
                                <div class="col-md-2">
                                    <div class="quantity-controls">
                                        <button class="btn btn-sm btn-outline-secondary" onclick="updateQuantity(${index}, -1)">
                                            <i class="fas fa-minus"></i>
                                        </button>
                                        <span class="quantity mx-2">${item.quantity}</span>
                                        <button class="btn btn-sm btn-outline-secondary" onclick="updateQuantity(${index}, 1)">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-1">
                                    <span class="item-total">Rs. ${(finalPrice * item.quantity).toLocaleString()}</span>
                                </div>
                                <div class="col-md-1">
                                    <button class="btn btn-sm btn-outline-danger" onclick="removeItem(${index})">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
            
            cartItemsContainer.innerHTML = html;
        }
        
        function updateQuantity(index, change) {
            cart[index].quantity += change;
            
            if (cart[index].quantity <= 0) {
                cart.splice(index, 1);
            }
            
            sessionStorage.setItem('cart', JSON.stringify(cart));
            displayCartItems();
            updateSummary();
            updateCartCount();
        }
        
        function removeItem(index) {
            cart.splice(index, 1);
            sessionStorage.setItem('cart', JSON.stringify(cart));
            displayCartItems();
            updateSummary();
            updateCartCount();
        }
        
        function updateSummary() {
            let subtotal = 0;
            
            cart.forEach(item => {
                const productData = products[item.productId];
                const unitPrice = productData?.bestQuote?.price || item.price || 0;
                const finalPrice = Math.round((unitPrice * 1.25) * 100) / 100; // Add 25% markup
                subtotal += finalPrice * item.quantity;
            });
            
            const shipping = subtotal > 10000 ? 0 : 999; // Free shipping over Rs. 10,000
            const total = subtotal + shipping; // No tax calculation
            
            document.getElementById('subtotal').textContent = `Rs. ${subtotal.toLocaleString()}`;
            document.getElementById('shipping').textContent = `Rs. ${shipping.toLocaleString()}`;
            document.getElementById('total').innerHTML = `<strong>Rs. ${total.toLocaleString()}</strong>`;
        }
        
        async function proceedToCheckout() {
            if (cart.length === 0) {
                showNotification('Your cart is empty!', 'warning');
                return;
            }
            
            try {
                // Check if user is logged in
                const isLoggedIn = await checkUserLoginStatus();
                
                if (!isLoggedIn) {
                    showNotification('Please login to proceed with checkout', 'warning');
                    setTimeout(() => {
                        window.location.href = '/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                    }, 1500);
                    return;
                }
                
                showNotification('Processing your order...', 'info');
                
                // Get customer details from registration
                const customerResponse = await fetch('/api/auth/customer', {
                    method: 'GET',
                    credentials: 'include'
                });
                
                if (!customerResponse.ok) {
                    showNotification('Unable to retrieve customer details. Please complete your profile.', 'error');
                    return;
                }
                
                const customerData = await customerResponse.json();
                
                // Prepare order data using customer registration details
                const orderItems = cart.map(item => {
                    const productData = products[item.productId];
                    const unitPrice = productData?.bestQuote?.price || item.price || 0;
                    const finalPrice = Math.round((unitPrice * 1.25) * 100) / 100;
                    
                    return {
                        globalId: item.globalId,
                        productName: productData?.productName || item.name || 'Unknown Product',
                        quantity: item.quantity,
                        unitPrice: finalPrice,
                        productDescription: productData?.description || '',
                        productImageUrl: productData?.bestQuote?.thumbnail || ''
                    };
                });
                
                // Use customer registration details automatically
                const orderData = {
                    customerId: customerData.customerId,
                    deliveryAddress: customerData.address || 'Address not provided',
                    customerName: customerData.name,
                    customerEmail: customerData.email,
                    customerPhone: customerData.phoneNumber,
                    notes: 'Order placed via automatic checkout',
                    items: orderItems
                };
                
                // Submit order to API
                const apiUrl = '@(Model.Configuration?["GadgetHubAPI:BaseUrl"] ?? "https://localhost:7063")';
                const response = await fetch(`${apiUrl}/api/Order`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(orderData)
                });
                
                if (response.ok) {
                    const orderResult = await response.json();
                    showNotification(`Order placed successfully! Order ID: #${orderResult.orderId}`, 'success');
                    
                    // Clear cart after successful order
                    sessionStorage.removeItem('cart');
                    loadCart();
                    
                    // Redirect to order details page
                    setTimeout(() => {
                        window.location.href = '/OrderDetails';
                    }, 2000);
                } else {
                    const errorData = await response.json();
                    showNotification(`Failed to place order: ${errorData.message || 'Unknown error'}`, 'error');
                }
                
            } catch (error) {
                console.error('Error placing order:', error);
                showNotification('Failed to place order. Please try again.', 'error');
            }
        }
        
        // Check if user is logged in
        async function checkUserLoginStatus() {
            try {
                const response = await fetch('/api/auth/check', {
                    method: 'GET',
                    credentials: 'include'
                });
                return response.ok;
            } catch (error) {
                console.error('Error checking login status:', error);
                return false;
            }
        }
        
        function continueShopping() {
            window.location.href = '/Products';
        }
        
        function updateCartCount() {
            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
            
            // Update cart count in header if element exists
            const cartCountElement = document.getElementById('cartCount');
            if (cartCountElement) {
                cartCountElement.textContent = totalItems;
            }
        }
        
        function showNotification(message, type) {
            // Create notification element
            const notification = document.createElement('div');
            notification.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
            notification.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
            notification.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            
            document.body.appendChild(notification);
            
            // Auto remove after 3 seconds
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.parentNode.removeChild(notification);
                }
            }, 3000);
        }
        
        // Initialize cart on page load
        document.addEventListener('DOMContentLoaded', function() {
            loadCart();
        });
    </script>
}
