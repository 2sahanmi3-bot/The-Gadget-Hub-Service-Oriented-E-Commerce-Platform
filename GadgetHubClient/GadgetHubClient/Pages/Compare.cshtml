@page
@model GadgetHubClient.Pages.CompareModel
@{
    ViewData["Title"] = "Compare Quotations";
}

<h2 class="mb-3">Compare Quotations</h2>

<form method="post" class="mb-4">
    <div class="form-group">
        <label>Product Global ID:</label>
        <input asp-for="ProductId" class="form-control" placeholder="Enter Product Global ID" required />
    </div>
    <div class="form-group mt-2">
        <label>Quantity:</label>
        <input asp-for="Quantity" type="number" min="1" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary mt-3">Compare</button>
</form>

@if (Model.Results != null && Model.Results.Any())
{
    <h4>Comparison Results</h4>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Product ID</th>
                <th>Chosen Distributor</th>
                <th>Best Price</th>
                <th>Delivery Days</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Results)
            {
                <tr>
                    <td>@item.GlobalId</td>
                    <td>@item.ChosenDistributor</td>
                    <td>@item.Price</td>
                    <td>@item.EstimatedDeliveryDays</td>
                </tr>
            }
        </tbody>
    </table>

    <h5>All Quotations</h5>
    @foreach (var q in Model.Results.SelectMany(r => r.AllQuotes))
    {
        <p><strong>@q.Distributor:</strong> @q.Price LKR (@q.AvailableQuantity available, @q.EstimatedDeliveryDays days)</p>
    }
}
