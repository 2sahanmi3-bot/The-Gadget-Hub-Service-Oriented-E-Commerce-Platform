@page
@model GadgetHubClient.Pages.Admin.OrdersModel
@{
	ViewData["Title"] = "Orders";
}

<section class="py-5">
	<div class="container">
		<h2 class="mb-4">All Orders</h2>

		@if (!string.IsNullOrEmpty(Model.StatusMessage))
		{
			<div class="alert alert-@(Model.IsSuccess ? "success" : "danger")">@Model.StatusMessage</div>
		}

		@if (Model.Orders.Any())
		{
			<div class="card border-0 shadow-sm">
				<div class="card-body">
					<div class="table-responsive">
						<table class="table table-striped align-middle">
							<thead>
								<tr>
									<th style="width: 70px;">ID</th>
									<th>Order Number</th>
									<th>Customer</th>
									<th>Email</th>
									<th>Phone</th>
									<th class="text-end">Total</th>
									<th>Status</th>
									<th>Order Date</th>
									<th>Estimated Delivery</th>
									<th>Delivery Address</th>
									<th>Notes</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var o in Model.Orders)
								{
									<tr>
										<td>@o.OrderId</td>
										<td>@o.OrderNumber</td>
										<td>@o.CustomerName</td>
										<td>@o.CustomerEmail</td>
										<td>@o.CustomerPhone</td>
										<td class="text-end">Rs. @o.TotalAmount.ToString("N2")</td>
										<td>
											<span class="badge bg-@(o.Status == "Completed" ? "success" : o.Status == "Processing" ? "warning" : o.Status == "Failed" ? "danger" : "secondary")">@o.Status</span>
										</td>
										<td>@o.OrderDate?.ToString("yyyy-MM-dd HH:mm")</td>
										<td>@o.EstimatedDeliveryDate?.ToString("yyyy-MM-dd")</td>
										<td>@o.DeliveryAddress</td>
										<td class="text-truncate" style="max-width: 260px;" title="@o.Notes">@o.Notes</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		}
		else
		{
			<div class="text-center py-5">
				<i class="fas fa-receipt fa-3x text-muted mb-3"></i>
				<h5>No orders found</h5>
				<p class="text-muted">Place an order to see it here.</p>
			</div>
		}
	</div>
</section>
