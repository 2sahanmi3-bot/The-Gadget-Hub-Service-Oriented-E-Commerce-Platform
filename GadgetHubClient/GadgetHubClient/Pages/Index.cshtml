@page
@model IndexModel
@{
    ViewData["Title"] = "The Gadget Hub - Latest Tech Products";
}

<!-- Modern Hero Section -->
<section class="modern-hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-100">
            <div class="col-lg-6">
                <div class="hero-content">
                    <h1 class="hero-title">
                        Great <span class="highlight-purple">Products</span> are built by great <span class="highlight-purple">teams</span>
                    </h1>
                    
                    <p class="hero-description">
                        We help build and manage a team of world-class developers to bring your vision to life. 
                        Explore top-tier smartphones, smart TVs, speakers, appliances, and more – all delivered fast, safe, and hassle-free with The Gadget Hub.
                    </p>
                    
                    <div class="hero-buttons">
                        <a href="/Products" class="btn btn-primary btn-lg">
                            Let's get started!
                        </a>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-6">
                <div class="hero-illustration">
                    <div class="illustration-container">
                        <!-- Main Dashboard -->
                        <div class="dashboard-window">
                            <div class="dashboard-header">
                                <div class="window-controls">
                                    <span class="control-dot red"></span>
                                    <span class="control-dot yellow"></span>
                                    <span class="control-dot green"></span>
                                </div>
                            </div>
                            <div class="dashboard-content">
                                <div class="chart-container">
                                    <div class="pie-chart"></div>
                                    <div class="bar-chart"></div>
                                </div>
                                <div class="social-icons">
                                    <i class="fas fa-thumbs-up"></i>
                                    <i class="fas fa-comment"></i>
                                    <i class="fas fa-heart"></i>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Team Characters -->
                        <div class="character character-1">
                            <div class="character-body">
                                <div class="gear gear-large"></div>
                                <div class="gear gear-small gear-1"></div>
                                <div class="gear gear-small gear-2"></div>
                                <div class="gear gear-small gear-3"></div>
                            </div>
                        </div>
                        
                        <div class="character character-2">
                            <div class="character-body">
                                <div class="tablet">
                                    <i class="fas fa-play"></i>
                                </div>
                            </div>
                        </div>
                        
                        <div class="character character-3">
                            <div class="character-body">
                                <div class="lightbulb">
                                    <i class="fas fa-lightbulb"></i>
                                </div>
                            </div>
                        </div>
                        
                        <div class="character character-4">
                            <div class="character-body">
                                <div class="smartphone">
                                    <i class="fas fa-mobile-alt"></i>
                                </div>
                            </div>
                        </div>
                        
                        <div class="character character-5">
                            <div class="character-body">
                                <div class="shopping-cart">
                                    <i class="fas fa-shopping-cart"></i>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Shopping Bag -->
                        <div class="shopping-bag">
                            <i class="fas fa-shopping-bag"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="features-section">
    <div class="container">
        <div class="row mb-5">
            <div class="col-12 text-center">
                <h2 class="section-title text-white">Why Choose Gadget Hub?</h2>
                <p class="section-subtitle text-white">Experience the difference with our premium services</p>
            </div>
        </div>
        
        <div class="row">
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-gem"></i>
                    </div>
                    <h5>Original Products</h5>
                    <p>Authentic, high-quality products crafted with care for lasting satisfaction.</p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <h5>30 Days Warranty</h5>
                    <p>Enjoy peace of mind with our hassle-free 30 days warranty coverage.</p>
                </div>
</div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-shipping-fast"></i>
                    </div>
                    <h5>Fast Delivery</h5>
                    <p>Lightning-fast delivery to your doorstep with real-time tracking.</p>
                </div>
</div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h5>100% Secure</h5>
                    <p>Shop confidently with secure payments and data protection guaranteed.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Smart Living Essentials Section -->
<section class="smart-living-section">
    <div class="container">
        <div class="row mb-5">
            <div class="col-12 text-center">
                <h2 class="section-title">Smart Living Essentials</h2>
                <p class="section-subtitle">
                    Upgrade your lifestyle with cutting-edge electronics and modern tech appliances - from smart TVs to smartphones, we bring technology and convenience to your home.
                </p>
                
                <!-- Category Tabs -->
                <div class="category-tabs mt-4">
                    <button class="btn btn-outline-primary active me-2" onclick="filterProducts('electric')">
                        <i class="fas fa-bolt me-2"></i>Electric Items
                    </button>
                    <button class="btn btn-outline-secondary me-2" onclick="filterProducts('audio')">
                        <i class="fas fa-volume-up me-2"></i>Audio Devices
                    </button>
                    <button class="btn btn-outline-secondary" onclick="filterProducts('wearables')">
                        <i class="fas fa-watch me-2"></i>Wearables
                    </button>
                </div>
            </div>
        </div>

        <!-- Product Grid -->
        <div class="row" id="productGrid">
            @if (Model.Products.Any())
            {
                @foreach (var product in Model.Products.Take(8))
                {
                    <div class="col-lg-3 col-md-6 mb-4 product-item" data-category="@product.Category.ToLower()">
                        <div class="product-card card h-100 border-0 shadow-lg">
                            <div class="product-image position-relative">
                                <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name">
                                <div class="product-badge">
                                    <span class="badge bg-danger">-20%</span>
                                </div>
                                <div class="product-overlay">
                                    <button class="btn btn-light" onclick="viewProduct('@product.GlobalId')">
                                        <i class="fas fa-eye me-2"></i>Quick View
                                    </button>
                                </div>
                            </div>
                            <div class="product-content">
                                <h6 class="product-title">@product.Name</h6>
                                <p class="product-description">@product.Description</p>
                                <div class="product-actions">
                                    <button class="btn btn-primary" onclick="viewProductDetails(@product.ProductId, '@product.Name')">
                                        <i class="fas fa-eye me-2"></i>View Details
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <div class="no-products-message">
                        <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                        <h4 class="text-muted">No Products Available</h4>
                        <p class="text-muted">We're currently updating our product catalog. Please check back soon!</p>
                        <a href="/Products" class="btn btn-outline-primary">
                            <i class="fas fa-refresh me-2"></i>Refresh Products
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- View All Products Button -->
        <div class="row mt-5">
            <div class="col-12 text-center">
                <a href="/Products" class="btn btn-primary btn-lg">
                    <i class="fas fa-th-large me-2"></i>View All Products
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action Section -->
<section class="cta-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h3 class="cta-title">Ready to Upgrade Your Tech?</h3>
                <p class="cta-description">
                    Join thousands of satisfied customers who have transformed their digital lifestyle with Gadget Hub. 
                    Get the latest technology delivered right to your doorstep.
                </p>
            </div>
            <div class="col-lg-4 text-end">
                <a href="/Products" class="btn btn-warning btn-lg">
                    <i class="fas fa-rocket me-2"></i>Start Shopping Now
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Floating Chat Widget -->
<div class="floating-chat-widget">
    <div class="chat-widget-content">
        <div class="chat-text">
            <span>Need Help? Chat with us</span>
        </div>
        <div class="chat-button">
            <a href="https://wa.me/94771234567" target="_blank" class="whatsapp-btn">
                <i class="fab fa-whatsapp"></i>
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Smooth scrolling for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Scroll animations
        function animateOnScroll() {
            const elements = document.querySelectorAll('.scroll-animate');
            elements.forEach(element => {
                const elementTop = element.getBoundingClientRect().top;
                const elementVisible = 150;
                
                if (elementTop < window.innerHeight - elementVisible) {
                    element.classList.add('animate');
                }
            });
        }

        // Filter products
        function filterProducts(category) {
            // Update active button
            document.querySelectorAll('.category-tabs .btn').forEach(btn => {
                btn.classList.remove('active', 'btn-outline-primary');
                btn.classList.add('btn-outline-secondary');
            });
            
            event.target.classList.add('active', 'btn-outline-primary');
            event.target.classList.remove('btn-outline-secondary');
            
            // Filter products with animation
            const productItems = document.querySelectorAll('.product-item');
            productItems.forEach((item, index) => {
                const itemCategory = item.dataset.category;
                if (category === 'electric' || itemCategory.includes(category)) {
                    item.style.display = 'block';
                    item.style.animationDelay = `${index * 0.1}s`;
                    item.classList.add('fade-in-up');
                } else {
                    item.style.display = 'none';
                    item.classList.remove('fade-in-up');
                }
            });
        }
        
        // Add to cart functionality
        function addToCart(globalId, name, price) {
            // Get existing cart from session storage
            let cart = JSON.parse(sessionStorage.getItem('cart') || '[]');
            
            // Check if item already exists
            const existingItem = cart.find(item => item.globalId === globalId);
            
            if (existingItem) {
                existingItem.quantity += 1;
            } else {
                cart.push({
                    globalId: globalId,
                    name: name,
                    price: price,
                    quantity: 1
                });
            }
            
            // Save cart to session storage
            sessionStorage.setItem('cart', JSON.stringify(cart));
            
            // Update cart count
            updateCartCount();
            
            // Show notification
            showNotification(`${name} added to cart!`, 'success');
        }
        
        // View product details functionality - Navigate to product details page
        function viewProductDetails(productId, productName) {
            // Navigate to the product details page
            window.location.href = `/ProductDetails/${productId}`;
        }

        // Show quotation details in modal
        function showQuotationModal(productName, quotationData) {
            // Calculate final price with 25% markup
            const bestPrice = quotationData.bestQuote?.price || 0;
            const markupPrice = bestPrice * 1.25; // Add 25% markup
            const finalPrice = Math.round(markupPrice * 100) / 100; // Round to 2 decimal places
            
            // Create modal HTML
            const modalHtml = `
                <div class="modal fade" id="quotationModal" tabindex="-1" aria-labelledby="quotationModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="quotationModalLabel">Product Details - ${productName}</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="product-details">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h6 class="text-primary">Product Information</h6>
                                            <p><strong>Product:</strong> ${productName}</p>
                                            <p><strong>Global ID:</strong> ${quotationData.globalId || 'N/A'}</p>
                                            <p><strong>Description:</strong> ${quotationData.bestQuote?.productName || productName}</p>
                                            <p><strong>Available Quantity:</strong> ${quotationData.bestQuote?.availableQuantity || 'N/A'}</p>
                                        </div>
                                        <div class="col-md-6">
                                            <h6 class="text-primary">Pricing Details</h6>
                                            <p><strong>Best Quote Price:</strong> <span class="text-info">Rs. ${bestPrice ? (bestPrice * 100).toLocaleString() : 'N/A'}</span></p>
                                            <p><strong>Markup (25%):</strong> <span class="text-warning">Rs. ${bestPrice ? ((bestPrice * 0.25) * 100).toLocaleString() : 'N/A'}</span></p>
                                            <hr>
                                            <p><strong>Final Price:</strong> <span class="text-success fw-bold fs-5">Rs. ${finalPrice ? (finalPrice * 100).toLocaleString() : 'N/A'}</span></p>
                                            <p><strong>Delivery Time:</strong> ${quotationData.bestQuote?.estimatedDeliveryDays || 'N/A'} days</p>
                                        </div>
</div>

                                    ${quotationData.allQuotes && quotationData.allQuotes.length > 0 ? `
                                    <hr>
                                    <h6 class="text-primary">All Available Quotes</h6>
                                    <div class="table-responsive">
                                        <table class="table table-striped">
                                            <thead>
                                                <tr>
                                                    <th>Distributor</th>
                                                    <th>Base Price (Rs.)</th>
                                                    <th>Final Price (Rs.)</th>
                                                    <th>Available Qty</th>
                                                    <th>Delivery Days</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                ${quotationData.allQuotes.map(quote => {
                                                    const quoteMarkupPrice = (quote.price || 0) * 1.25;
                                                    const quoteFinalPrice = Math.round(quoteMarkupPrice * 100) / 100;
                                                    return `
                                                        <tr>
                                                            <td>${quote.distributor || 'N/A'}</td>
                                                            <td class="fw-bold">${quote.price ? (quote.price * 100).toLocaleString() : 'N/A'}</td>
                                                            <td class="fw-bold text-success">${quoteFinalPrice ? (quoteFinalPrice * 100).toLocaleString() : 'N/A'}</td>
                                                            <td>${quote.availableQuantity || 'N/A'}</td>
                                                            <td>${quote.estimatedDeliveryDays || 'N/A'} days</td>
                                                        </tr>
                                                    `;
                                                }).join('')}
                                            </tbody>
                                        </table>
                                    </div>
                                    ` : ''}
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                ${quotationData.bestQuote?.price ? `
                                <button type="button" class="btn btn-success" onclick="placeOrder('${quotationData.globalId}', '${productName}', ${finalPrice}, '${quotationData.bestQuote.distributor}')">
                                    <i class="fas fa-shopping-bag me-2"></i>Place Order
                                </button>
                                ` : ''}
                            </div>
                        </div>
                    </div>
                </div>
            `;

            // Remove existing modal if any
            const existingModal = document.getElementById('quotationModal');
            if (existingModal) {
                existingModal.remove();
            }

            // Add modal to page
            document.body.insertAdjacentHTML('beforeend', modalHtml);

            // Show modal
            const modal = new bootstrap.Modal(document.getElementById('quotationModal'));
            modal.show();

            // Clean up modal when hidden
            document.getElementById('quotationModal').addEventListener('hidden.bs.modal', function() {
                this.remove();
            });
        }

        // Place order functionality
        async function placeOrder(globalId, productName, finalPrice, distributor) {
            try {
                // Show loading state
                const button = event.target;
                const originalText = button.innerHTML;
                button.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Placing Order...';
                button.disabled = true;

                // Check if user is logged in
                const userId = sessionStorage.getItem('userId');
                const customerId = sessionStorage.getItem('customerId');
                if (!userId || !customerId) {
                    showNotification('Please login to place an order', 'warning');
                    // Redirect to login page
                    window.location.href = '/Login';
                    return;
                }

                // Get customer address (you might want to get this from user profile)
                const deliveryAddress = prompt('Please enter your delivery address:');
                if (!deliveryAddress) {
                    showNotification('Delivery address is required', 'error');
                    return;
                }

                // Create order data matching OrderRequestDTO structure
                const orderData = {
                    CustomerId: parseInt(customerId),
                    OrderItems: [{
                        GlobalId: globalId,
                        ProductName: productName,
                        Quantity: 1,
                        UnitPrice: finalPrice,
                        ImageUrl: '' // You can get this from product data if needed
                    }],
                    PaymentMethod: 'Cash on Delivery',
                    DeliveryAddress: deliveryAddress,
                    Notes: `Order placed for ${productName} from ${distributor}`
                };

                // Call GadgetHubAPI to place order
                const apiBaseUrl = '@Html.Raw(Model.Configuration?["GadgetHubAPI:BaseUrl"] ?? "http://localhost:5286")';
                const orderUrl = `${apiBaseUrl}/api/Order/place`;

                const response = await fetch(orderUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(orderData)
                });

                if (response.ok) {
                    const orderResponse = await response.json();
                    showNotification(`Order placed successfully! Order Number: ${orderResponse.orderNumber || 'N/A'}`, 'success');
                    
                    // Close modal
                    const modal = bootstrap.Modal.getInstance(document.getElementById('quotationModal'));
                    if (modal) {
                        modal.hide();
                    }
                } else {
                    const errorData = await response.json();
                    showNotification(`Failed to place order: ${errorData.message || 'Unknown error'}`, 'error');
                }
            } catch (error) {
                console.error('Error placing order:', error);
                showNotification('Failed to place order. Please try again.', 'error');
            } finally {
                // Restore button state
                const button = event.target;
                button.innerHTML = originalText;
                button.disabled = false;
            }
        }

        // Add to cart from quotation
        function addToCartFromQuotation(globalId, name, price) {
            addToCart(globalId, name, price);
            // Close modal
            const modal = bootstrap.Modal.getInstance(document.getElementById('quotationModal'));
            if (modal) {
                modal.hide();
            }
        }
        
        // Update cart count
        function updateCartCount() {
            const cart = JSON.parse(sessionStorage.getItem('cart') || '[]');
            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
            
            const cartCountElement = document.getElementById('cartCount');
            if (cartCountElement) {
                cartCountElement.textContent = totalItems;
                cartCountElement.style.display = totalItems > 0 ? 'inline' : 'none';
            }
        }
        
        // Show notification
        function showNotification(message, type) {
            const notification = document.createElement('div');
            notification.className = `alert alert-${type === 'error' ? 'danger' : type} alert-dismissible fade show position-fixed`;
            notification.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px; box-shadow: 0 10px 30px rgba(0,0,0,0.2);';
            notification.innerHTML = `
                <div class="d-flex align-items-center">
                    <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'} me-2"></i>
                    ${message}
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            
            document.body.appendChild(notification);
            
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.parentNode.removeChild(notification);
                }
            }, 3000);
        }
        
        // Back to top button
        function createBackToTopButton() {
            const backToTop = document.createElement('button');
            backToTop.className = 'back-to-top';
            backToTop.innerHTML = '<i class="fas fa-arrow-up"></i>';
            backToTop.onclick = () => window.scrollTo({ top: 0, behavior: 'smooth' });
            document.body.appendChild(backToTop);
            
            window.addEventListener('scroll', () => {
                if (window.pageYOffset > 300) {
                    backToTop.classList.add('show');
                } else {
                    backToTop.classList.remove('show');
                }
            });
        }
        
        // Initialize everything on page load
        document.addEventListener('DOMContentLoaded', function() {
            updateCartCount();
            createBackToTopButton();
            
            // Add scroll animation classes
            const elementsToAnimate = document.querySelectorAll('.hero-content, .hero-visual, .category-card, .feature-card, .product-item');
            elementsToAnimate.forEach(element => {
                element.classList.add('scroll-animate');
            });
            
            // Initial animation check
            animateOnScroll();
            
            // Add scroll event listener
            window.addEventListener('scroll', animateOnScroll);
            
            // Add loading animation to buttons
            document.querySelectorAll('.btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    if (this.href && this.href.includes('#')) return;
                    
                    const originalText = this.innerHTML;
                    this.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Loading...';
                    this.disabled = true;
                    
                    setTimeout(() => {
                        this.innerHTML = originalText;
                        this.disabled = false;
                    }, 1000);
                });
            });
        });
        
        // Add parallax effect to hero section
        window.addEventListener('scroll', () => {
            const scrolled = window.pageYOffset;
            const parallax = document.querySelector('.hero-section');
            if (parallax) {
                const speed = scrolled * 0.5;
                parallax.style.transform = `translateY(${speed}px)`;
            }
        });
    </script>
}